# Environment Variables Configuration (for Vercel / Railway / Cloud Deployment)

# Cloud MySQL Database Credentials
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=coffeeshop_db
DB_USER=xxxxxx.root
